      "palette": [
        {
          "slug": "cbn-black",
          "color": "#111111",
          "name": "CBN Black"
        },
        {
          "slug": "cbn-red",
          "color": "#c90018",
          "name": "CBN Red"
        },
        {
          "slug": "cbn-red-dark",
          "color": "#970014",
          "name": "CBN Dark Red"
        },
        {
          "slug": "cbn-white",
          "color": "#ffffff",
          "name": "CBN White"
        },
        {
          "slug": "cbn-soft",
          "color": "#f6f6f7",
          "name": "CBN Soft White"
        }
