COMPOSE_PROJECT_NAME=cbn

# Local WordPress/Docker only. Do not paste production secrets here.
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8081

WORDPRESS_IMAGE=wordpress:php8.3-apache
WORDPRESS_CLI_IMAGE=wordpress:cli-php8.3
MARIADB_IMAGE=mariadb:11
PHPMYADMIN_IMAGE=phpmyadmin:apache

WORDPRESS_DB_NAME=cbn_wordpress
WORDPRESS_DB_USER=cbn
WORDPRESS_DB_PASSWORD=cbn_password
WORDPRESS_DB_ROOT_PASSWORD=root_password
WORDPRESS_TABLE_PREFIX=wp_
WORDPRESS_DEBUG=1
WORDPRESS_ENVIRONMENT_TYPE=local
WORDPRESS_MEMORY_LIMIT=256M

# Future integrations must be configured with test credentials first.
# Keep real provider secrets in the hosting secret/config system or WordPress admin,
# never in Git, docs, screenshots or chat logs.
CBN_PAYMENT_PROVIDER=
CBN_STRIPE_MODE=test
CBN_STRIPE_WEBHOOK_SECRET=
CBN_FEDERATION_SOURCE=
CBN_FEDERATION_BASE_URL=
