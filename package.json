{
  "name": "club-baloncesto-navalcarnero",
  "version": "0.1.0",
  "private": true,
  "description": "WordPress theme setup for the Club Baloncesto Navalcarnero website redesign.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run format:check && npm run build",
    "format": "prettier --write \"**/*.{css,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{css,js,json,md,yml,yaml}\""
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.25",
    "swiper": "14.0.0"
  },
  "devDependencies": {
    "prettier": "3.9.0",
    "vite": "8.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
